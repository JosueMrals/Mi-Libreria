# Firebase / SQL Connect configuration example
# Fill in real values only in a local environment you control.
# Never commit a real .env file with secrets.

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

DATACONNECT_SERVICE_ID=libreriasystem
CLOUD_SQL_REGION=us-east4
CLOUD_SQL_INSTANCE_ID=libreriasystem-fdc
CLOUD_SQL_DATABASE=fdcdb
